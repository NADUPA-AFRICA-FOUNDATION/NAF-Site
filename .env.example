# Supabase (public site data + forms)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Required for admin operations (bypasses RLS) - server-side only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin panel login (server-side only)
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=choose-a-strong-password
# Random secret used to sign admin session cookies (32+ characters), e.g. `openssl rand -hex 32`
ADMIN_SESSION_SECRET=

# Email notifications (optional - emails are skipped if unset)
RESEND_API_KEY=

# File uploads (Vercel Blob)
BLOB_READ_WRITE_TOKEN=
