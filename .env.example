# Convex (form submissions + admin 2FA). `npx convex dev` fills in the first two.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Shared secret the Next.js server sends with every Convex call (32+ chars), e.g. `openssl rand -hex 32`.
# Set the SAME value on the Convex deployment: `npx convex env set CONVEX_SERVER_SECRET <value>`
CONVEX_SERVER_SECRET=

# Supabase (documents library)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Required for admin operations (bypasses RLS) - server-side only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin panel login (server-side only). Two-factor authentication (authenticator app) is
# required: the first sign-in walks through QR-code setup and shows 10 one-time backup codes.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=choose-a-strong-password
# Random secret used to sign admin session cookies and encrypt 2FA secrets (32+ characters),
# e.g. `openssl rand -hex 32`. Changing it signs everyone out and invalidates enrolled 2FA.
ADMIN_SESSION_SECRET=

# Email notifications (optional - emails are skipped if unset)
RESEND_API_KEY=

# File uploads (Vercel Blob)
BLOB_READ_WRITE_TOKEN=
