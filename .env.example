# Convex: the site's only backend (forms, page content, documents and files, admin 2FA). `npx convex dev` fills in the first two.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Shared secret the Next.js server sends with every Convex call (32+ chars), e.g. `openssl rand -hex 32`.
# Set the SAME value on the Convex deployment: `npx convex env set CONVEX_SERVER_SECRET <value>`
CONVEX_SERVER_SECRET=

# Admin panel sign-in (server-side only). Admins sign in with Google or an emailed link,
# then a code from an authenticator app (set up on first sign-in, with 10 backup codes).
# Comma-separated list of addresses allowed in:
ADMIN_EMAILS=you@nadupaafricafoundation.org,yourname@gmail.com
# Random secret used to sign sign-in links/sessions and encrypt 2FA secrets (32+ characters),
# e.g. `openssl rand -hex 32`. Changing it signs everyone out and invalidates enrolled 2FA.
ADMIN_SESSION_SECRET=
# Public site URL used in sign-in links and the Google redirect (recommended in production)
ADMIN_BASE_URL=https://www.nadupaafricafoundation.org
# Optional "Sign in with Google" (Google Cloud console -> APIs & Services -> Credentials ->
# OAuth client ID, type Web application). Authorized redirect URI:
#   https://www.nadupaafricafoundation.org/api/admin/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email notifications (optional - emails are skipped if unset)
RESEND_API_KEY=

